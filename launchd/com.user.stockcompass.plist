<?xml version="1.0" encoding="UTF-8"?>
<!--
  stock-compass launchd 설정 템플릿

  install_launchd.sh가 {{PROJECT_PATH}}, {{UV_PATH}}을 자동 치환 후
  ~/Library/LaunchAgents/com.user.stockcompass.plist 로 복사.

  3개의 시간 분기로 동작:
  - 평일 06:30 KST: 미국 시장 배치 + 알림 체크
  - 평일 07:00 KST: 일일 종합 리포트 + Craft 발행
  - 평일 16:30 KST: 한국 시장 배치 + 알림 체크

  Mac 절전 모드에서는 실행 X — pmset 또는 카페인 앱으로 보완 필요.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.stockcompass</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{UV_PATH}}</string>
    <string>run</string>
    <string>--project</string>
    <string>{{PROJECT_PATH}}</string>
    <string>stock-compass</string>
    <string>batch-and-alert</string>
  </array>

  <key>WorkingDirectory</key>
  <string>{{PROJECT_PATH}}</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>TZ</key>
    <string>Asia/Seoul</string>
  </dict>

  <!-- 실행 시각 (KST). 평일만 (월요일=2 ~ 금요일=6). -->
  <key>StartCalendarInterval</key>
  <array>
    <!-- 미국 시장 마감 후 배치 (06:30 KST = NYSE 마감 +1.5h) -->
    <dict>
      <key>Weekday</key><integer>2</integer>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>3</integer>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>4</integer>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>5</integer>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>6</integer>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>30</integer>
    </dict>

    <!-- 일일 종합 리포트 (07:00 KST = 출근 전) -->
    <dict>
      <key>Weekday</key><integer>2</integer>
      <key>Hour</key><integer>7</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>3</integer>
      <key>Hour</key><integer>7</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>4</integer>
      <key>Hour</key><integer>7</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>5</integer>
      <key>Hour</key><integer>7</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>6</integer>
      <key>Hour</key><integer>7</integer>
      <key>Minute</key><integer>0</integer>
    </dict>

    <!-- 한국 시장 마감 후 배치 (16:30 KST = KRX 마감 +1h) -->
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>16</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>2</integer>
      <key>Hour</key><integer>16</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>3</integer>
      <key>Hour</key><integer>16</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>4</integer>
      <key>Hour</key><integer>16</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>5</integer>
      <key>Hour</key><integer>16</integer>
      <key>Minute</key><integer>30</integer>
    </dict>

    <!-- 유니버스 주간 재채점 (토요일 05:00 KST). weekly-discover(08:00) 전 853종목
         composite 신선화 → v_latest_scores 갱신. ~45-60분 소요(06:30 US 배치 전 종료).
         DB busy_timeout 미설정이라 다른 쓰기 잡과 안 겹치게 05:00 단독 슬롯 사용. -->
    <dict>
      <key>Weekday</key><integer>6</integer>
      <key>Hour</key><integer>5</integer>
      <key>Minute</key><integer>0</integer>
    </dict>

    <!-- 주간 종목 발굴 (토요일 08:00 KST). launchd 컨벤션: 0/7=일요일, 1=월…6=토. -->
    <dict>
      <key>Weekday</key><integer>6</integer>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>

  <!-- 로그 -->
  <key>StandardOutPath</key>
  <string>{{PROJECT_PATH}}/logs/launchd-stdout.log</string>
  <key>StandardErrorPath</key>
  <string>{{PROJECT_PATH}}/logs/launchd-stderr.log</string>

  <!-- 실패 시 자동 재시작 X (배치성 잡) -->
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>

  <!-- CPU 낮은 우선순위 (배경 작업) -->
  <key>ProcessType</key>
  <string>Background</string>

  <!-- 절전 모드에서도 깨우기 (선택, 부팅 시 시스템 결정) -->
  <key>WakeFromSleep</key>
  <true/>
</dict>
</plist>
