# ====================================
# stock-compass 환경변수
# ====================================
# 사용법: cp .env.example .env.local 후 실제 값 입력
# ⚠️ .env.local 절대 git 커밋 금지

# ─────────────────────────────────────
# 시장·워치리스트 (필수)
# ─────────────────────────────────────
# 기본 시장: KR 또는 US
DEFAULT_MARKET=KR

# 한국 종목 코드 (6자리, 콤마 구분)
# 예: 삼성전자, 카카오, SK하이닉스, NAVER, 현대차
WATCHLIST_KR=005930,035720,000660,035420,005380

# 미국 티커 (콤마 구분)
WATCHLIST_US=AAPL,MSFT,NVDA,GOOGL,TSLA

# ─────────────────────────────────────
# Anthropic Claude API (필수)
# https://console.anthropic.com → Keys
# 용도: 뉴스·공시 요약 (sentiment 팩터)
# ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-

# 사용 모델 (기본: haiku, 본문 길면 sonnet 자동 전환)
ANTHROPIC_MODEL_DEFAULT=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_HEAVY=claude-sonnet-4-6

# 일 토큰 한도 (비용 안전장치)
ANTHROPIC_DAILY_INPUT_LIMIT=500000
ANTHROPIC_DAILY_OUTPUT_LIMIT=100000

# ─────────────────────────────────────
# FRED API (필수, 미국 거시 데이터)
# https://fred.stlouisfed.org/docs/api/api_key.html
# 용도: VIX, 10Y 금리, DXY → Macro 팩터
# ─────────────────────────────────────
FRED_API_KEY=

# ─────────────────────────────────────
# DART OpenAPI (KR 사용 시 필수)
# https://opendart.fss.or.kr
# 용도: 한국 공시 (정기보고서·내부자 거래·자사주 등)
# ⚠️ 일 10,000건 한도
# ─────────────────────────────────────
DART_API_KEY=

# ─────────────────────────────────────
# Naver 검색 API (선택, KR 뉴스 강화)
# https://developers.naver.com/apps
# 용도: 한국 뉴스 검색 → sentiment 팩터 보강
# 미설정 시 yfinance.news로 대체 (KR은 데이터 빈약)
# ─────────────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─────────────────────────────────────
# KRX 로그인 (선택, 정확한 KOSPI200/KOSDAQ150 지수 구성)
# https://data.krx.co.kr → 회원가입 (무료)
# 용도: pykrx 지수 구성종목 정확 조회 (KRX가 해당 데이터를 로그인 뒤로 이전)
# 미설정 시 FinanceDataReader 시총상위 N 프록시로 자동 폴백 (정확 지수는 아님)
# ─────────────────────────────────────
KRX_ID=
KRX_PW=

# ─────────────────────────────────────
# Craft API (선택, Phase 5+)
# Craft → Settings → API → Generate Token
# 용도: 일일 노트 직접 발행 (Folder Watch 대신)
# 미설정 시 data/craft_export/*.md 파일만 생성
# ─────────────────────────────────────
CRAFT_API_TOKEN=
CRAFT_DAILY_FOLDER_ID=
CRAFT_TICKERS_FOLDER_ID=

# ─────────────────────────────────────
# Obsidian 자동 보고 (dual-sink)
# 자동화 task가 결과 보고를 볼트의 <reports_subdir>/<종류>/ 폴더에 .md 직접 기록.
# launchd 독립 프로세스라 MCP 불가 — 파일시스템 직접 쓰기.
# 미설정/미존재(iCloud 미동기) 시 graceful skip. 기본값은 config.py 참조.
# ─────────────────────────────────────
# OBSIDIAN_VAULT_DIR=/Users/<you>/Library/Mobile Documents/iCloud~md~obsidian/Documents/<Vault>
OBSIDIAN_REPORTS_SUBDIR=03. Stock-Compass/Reports

# ─────────────────────────────────────
# 점수 임계치·알림 (조정 가능)
# ─────────────────────────────────────
# 관심권 진입 점수
ALERT_THRESHOLD_BUY=80

# 주의 진입 점수
ALERT_THRESHOLD_CAUTION=30

# 점수 급변 임계 (24h)
ALERT_DELTA_MIN=15

# 일일 리포트 시각 (KST, HH:MM)
DAILY_REPORT_TIME=07:00

# ─────────────────────────────────────
# 유지보수 retention (디스크 누적 방지)
# ─────────────────────────────────────
# DB 백업 보존 개수 (700MB+ 라 개수 기반, 기본 7 = 직전 1주)
BACKUP_RETENTION_COUNT=7
# craft_export *.bak 원본별 유지 개수
CRAFT_EXPORT_BACKUP_KEEP=5
# 배치 실패율 이 비율 초과 시 macOS 알림 (0.3 = 30%)
BATCH_FAILURE_ALERT_RATIO=0.3

# ─────────────────────────────────────
# 데이터 경로 (보통 변경 X)
# ─────────────────────────────────────
DB_PATH=data/stock_compass.db
CACHE_DIR=data/cache
LOG_DIR=logs
CRAFT_EXPORT_DIR=data/craft_export

# ─────────────────────────────────────
# 외부 호출 동작 (조정 가능)
# ─────────────────────────────────────
# yfinance 종목 간 sleep (초)
YFINANCE_THROTTLE_SEC=0.5

# 외부 API 재시도 횟수
EXTERNAL_API_RETRY=3

# 외부 API 타임아웃 (초)
EXTERNAL_API_TIMEOUT=10

# 24h 캐시 사용 (true/false)
ENABLE_CACHE=true
